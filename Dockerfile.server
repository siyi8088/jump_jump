# ─── 基础 ───
FROM node:22-alpine

WORKDIR /app

# 复制 package 文件
COPY server/package.json server/package-lock.json* ./

# 安装依赖
RUN npm install --production

# 复制源码
COPY server/src ./src
COPY server/tsconfig.json ./

# 安装 tsx 用于运行 TS
RUN npm install tsx

# 暴露端口
EXPOSE 3001

# 启动
CMD ["npx", "tsx", "src/index.ts"]
